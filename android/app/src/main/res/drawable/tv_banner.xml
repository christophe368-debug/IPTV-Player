<?xml version="1.0" encoding="utf-8"?>
<!--
  Einfaches Platzhalter-Banner fuer den Android-TV-Launcher (320x180dp
  Pflichtformat). Bis es ein eigenes TV-Banner-Design gibt, reicht das,
  damit die App im TV-Launcher ueberhaupt korrekt angezeigt wird.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tv_banner_background" />
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
